# ESG Analytics Platform environment template
# Copy to a private .env file for local use, or configure these values in your deployment secret store.
# Never commit real credentials, encryption keys, or private filesystem paths.

# SQLite database file. Leave blank to use the application's project-local default.
ESG_DATABASE_PATH=

# Required for Platform Super Admin and Company Manager MFA.
# Generate/manage this key securely; preserve the same key for an existing database.
ESG_MFA_ENCRYPTION_KEY=

# Optional SMTP settings for password-reset email. Host, user, and password are needed to send email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional sender address; defaults to SMTP_USER when blank.
SMTP_FROM=

# Login throttling: maximum failures, rolling window, and lockout duration in seconds.
# Defaults: 5 attempts, 900-second window, 900-second lockout.
ESG_LOGIN_MAX_ATTEMPTS=5
ESG_LOGIN_WINDOW_SECONDS=900
ESG_LOGIN_LOCKOUT_SECONDS=900

# Password-reset throttling: maximum requests, rolling window, and lockout duration in seconds.
# Defaults: 3 attempts, 3600-second window, 3600-second lockout.
ESG_RESET_MAX_ATTEMPTS=3
ESG_RESET_WINDOW_SECONDS=3600
ESG_RESET_LOCKOUT_SECONDS=3600

# MFA verification throttling: maximum failures, rolling window, and lockout duration in seconds.
# Defaults: 5 attempts, 900-second window, 900-second lockout.
ESG_MFA_MAX_ATTEMPTS=5
ESG_MFA_WINDOW_SECONDS=900
ESG_MFA_LOCKOUT_SECONDS=900

# Optional feature switches. Accepted setting is true or false; defaults are true.
ENABLE_EXTERNAL_CO2=true
ENABLE_VISUALIZATIONS=true
ENABLE_REPORTS=true
